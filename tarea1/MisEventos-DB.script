CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE USUARIOS(NICKNAME VARCHAR(100) NOT NULL PRIMARY KEY,DTYPE VARCHAR(31),EMAIL VARCHAR(200) NOT NULL,NOMBRE VARCHAR(200) NOT NULL,PASS VARCHAR(200) NOT NULL,CONSTRAINT UNQ_USUARIOS_0 UNIQUE(NICKNAME),CONSTRAINT UNQ_USUARIOS_2 UNIQUE(EMAIL))
CREATE MEMORY TABLE ASISTENTES(NICKNAME VARCHAR(100) NOT NULL PRIMARY KEY,APELLIDO VARCHAR(200) NOT NULL,FECHA_NACIMIENTO DATE NOT NULL,CONSTRAINT FK_ASISTENTES_NICKNAME FOREIGN KEY(NICKNAME) REFERENCES USUARIOS(NICKNAME))
CREATE MEMORY TABLE ORGANIZADORES(NICKNAME VARCHAR(100) NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(1000),URL VARCHAR(500),CONSTRAINT FK_ORGANIZADORES_NICKNAME FOREIGN KEY(NICKNAME) REFERENCES USUARIOS(NICKNAME))
CREATE MEMORY TABLE EDICIONES(NOMBRE VARCHAR(200) NOT NULL PRIMARY KEY,CIUDAD VARCHAR(200),FECHA_ALTA DATE NOT NULL,FECHA_ARCHIVO DATE,FECHA_FIN DATE,FECHA_INICIO DATE,PAIS VARCHAR(200),SIGLA VARCHAR(50),VIDEO_URL VARCHAR(500),ORGANIZADOR_NICKNAME VARCHAR(100) NOT NULL,CONSTRAINT UNQ_EDICIONES_0 UNIQUE(NOMBRE),CONSTRAINT FK_EDICIONES_ORGANIZADOR_NICKNAME FOREIGN KEY(ORGANIZADOR_NICKNAME) REFERENCES USUARIOS(NICKNAME))
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
